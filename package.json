{
  "name": "webscraper-action",
  "version": "1.0.0",
  "description": "Scheduled web scraper GitHub Action for sportybet.com/gh/m/",
  "type": "module",
  "main": "scraper.js",
  "scripts": {
    "scrape": "node scraper.js",
    "build-db": "node build-db.mjs",
    "resolve": "node resolve-results.mjs",
    "analyze": "node analyze-odds.mjs --db",
    "compare": "node compare-coverage.mjs",
    "winners": "node winners.mjs",
    "prematch": "node prematch-monitor.mjs",
    "live": "node live-monitor.mjs",
    "share-code": "node share-code.mjs",
    "manual-slip": "node manual-slip.mjs",
    "build:agent": "tsc -p agent/tsconfig.json",
    "agent": "npm run build:agent && node dist/cli.js",
    "agent:confirm": "node dist/confirm.js",
    "agent:monitor": "node dist/monitor.js",
    "stake": "node stake.mjs",
    "stake-placement": "node stake-placement.mjs",
    "stake-autoplace": "node stake-autoplace.mjs",
    "paper-B": "node paper-B.mjs",
    "engine": "node engine/daily-engine.mjs",
    "test": "npm run build:agent && node --test test/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
